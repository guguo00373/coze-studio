# Settings for Embedding
export EMBEDDING_TYPE="openai"
export EMBEDDING_MAX_BATCH_SIZE=100

# openai embedding (required for knowledge base)
# IMPORTANT: eino's OpenAI client appends /v1/embeddings to BaseURL automatically.
# Use the base URL WITHOUT the trailing /embeddings, otherwise the request
# will be sent to /v1/embeddings/v1/embeddings and return 404 "Not Found".
export OPENAI_EMBEDDING_BASE_URL="https://api.siliconflow.cn/v1"   # (string, required) OpenAI embedding base_url
export OPENAI_EMBEDDING_MODEL="BAAI/bge-m3"         # (string, required) OpenAI embedding model
export OPENAI_EMBEDDING_API_KEY="sk-your-key"        # (string, required) OpenAI embedding api_key
export OPENAI_EMBEDDING_BY_AZURE=false    # (bool,   optional) OpenAI embedding by_azure
export OPENAI_EMBEDDING_API_VERSION=""    # (string, optional) OpenAI embedding azure api version
export OPENAI_EMBEDDING_DIMS=1024         # (int,    required) OpenAI embedding dimensions
export OPENAI_EMBEDDING_REQUEST_DIMS=1024 # (int,    optional) OpenAI embedding dimensions in requests

